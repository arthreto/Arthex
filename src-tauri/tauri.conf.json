{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arthex",
  "version": "0.2.20",
  "identifier": "dev.arthreto.arthex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arthex",
        "url": "index.html",
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' arthex-module: http://arthex-module.localhost; img-src 'self' data: asset: http://asset.localhost arthex-module: http://arthex-module.localhost; media-src arthex-module: http://arthex-module.localhost; style-src 'self' 'unsafe-inline' arthex-module: http://arthex-module.localhost; font-src 'self' arthex-module: http://arthex-module.localhost; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A fast overlay for shortcuts, search and everyday tools.",
    "copyright": "© 2026 arthreto",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": [
          "arthex"
        ],
        "name": "Arthex module",
        "description": "Arthex module",
        "mimeType": "application/x-arthex-module",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "French"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGMjQ2Njk3MTI4NzRBRTYKUldUbVNvY1NsMllrRHdnb3NBWU1MTkRWRlhSK0lMMTZPdklPN2RmaHc0YjVuY2d1ay8vWHpDSEMK",
      "endpoints": [
        "https://github.com/arthreto/Arthex/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
