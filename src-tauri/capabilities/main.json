{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the overlay window is allowed to call.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-settings-get",
    "allow-settings-update",
    "allow-overlay-hide",
    "allow-hotkey-record",
    "allow-app-info",
    "allow-app-open-data-dir",
    "allow-app-uninstall",
    "allow-shortcuts-list",
    "allow-shortcuts-save-site",
    "allow-shortcuts-save-app",
    "allow-shortcuts-remove",
    "allow-shortcuts-restore",
    "allow-shortcuts-reorder",
    "allow-shortcuts-programs",
    "allow-shortcuts-browse-program",
    "allow-shortcuts-pick-icon",
    "allow-shortcuts-open",
    "allow-recent-apps-list",
    "allow-recent-apps-open",
    "allow-recent-apps-clear"
  ]
}
